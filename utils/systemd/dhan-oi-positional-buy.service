[Unit]
Description=Dhan OIPositionalBuy engine (PAPER) — python -m run.main --engine-id dhan_oi_positional_buy
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=86400
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/root/Dhan-codebase
EnvironmentFile=-/root/Dhan-codebase/.env
ExecStart=/root/Dhan-codebase/.venv/bin/python -m run.main --engine-id dhan_oi_positional_buy
Restart=on-failure
RestartSec=300
TimeoutStopSec=120
StandardOutput=append:/root/dhan-oi-positional-buy.log
StandardError=append:/root/dhan-oi-positional-buy.err.log

[Install]
WantedBy=multi-user.target
