[Unit]
Description=Sync crypto indicator history gaps (BTCUSD/PAXGUSD)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/Dhan-codebase
ExecStart=/home/ubuntu/Dhan-codebase/.venv/bin/python /home/ubuntu/Dhan-codebase/utils/delta/sync_crypto_indicator_gaps.py
