[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/Dhan-codebase
ExecStart=/home/ubuntu/Dhan-codebase/.venv/bin/python /home/ubuntu/Dhan-codebase/utils/delta/refresh_delta_instruments.py
