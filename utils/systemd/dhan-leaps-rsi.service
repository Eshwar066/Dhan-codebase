[Unit]
Description=Dhan LEAPS_RSI engine (LIVE) — python -m run.main --engine-id dhan_leaps_rsi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Dhan-codebase
EnvironmentFile=-/root/Dhan-codebase/.env
ExecStart=/root/Dhan-codebase/.venv/bin/python -m run.main --engine-id dhan_leaps_rsi
Restart=always
RestartSec=20
TimeoutStopSec=120
StandardOutput=append:/root/dhan-leaps-rsi.log
StandardError=append:/root/dhan-leaps-rsi.err.log

[Install]
WantedBy=multi-user.target
