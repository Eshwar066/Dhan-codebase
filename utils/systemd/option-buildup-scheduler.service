[Unit]
Description=Option buildup 5m scheduler (run/option_buildup_scheduler.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Dhan-codebase
EnvironmentFile=-/root/Dhan-codebase/.env
# Repo root on PYTHONPATH so `from core...` works when executing the script file directly.
Environment=PYTHONPATH=/root/Dhan-codebase
# Line-buffered stdout/stderr so journalctl shows prints promptly (not only on crash/restart).
Environment=PYTHONUNBUFFERED=1
# Uses DHAN_CLIENT_CODE and DHAN_ACCESS_TOKEN from .env (see DhanSource).
# Adjust --symbols / --exchange / add --all-day on the ExecStart line as needed.
ExecStart=/root/Dhan-codebase/.venv/bin/python run/option_buildup_scheduler.py --symbols NIFTY --exchange NSE
Restart=always
RestartSec=20
TimeoutStopSec=120
# Send process output to the journal (use: journalctl -u option-buildup-scheduler.service -f)
SyslogIdentifier=option-buildup-scheduler
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
