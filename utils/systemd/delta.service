[Unit]
Description=Delta Engine
After=network.target
Wants=network-online.target
StartLimitIntervalSec=86400
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Dhan-codebase
EnvironmentFile=-/home/ubuntu/Dhan-codebase/.env
ExecStart=/home/ubuntu/Dhan-codebase/.venv/bin/python -m run.main --venue DELTA
Restart=always
RestartSec=5
StandardOutput=append:/home/ubuntu/Dhan-codebase/logs/delta.log
StandardError=append:/home/ubuntu/Dhan-codebase/logs/delta.err.log

[Install]
WantedBy=multi-user.target
