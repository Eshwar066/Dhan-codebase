[Unit]
Description=Legacy alias — use dhan-leaps-rsi.service + dhan-oi-positional-buy.service (or dhan-dual.target)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=86400
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/root/Dhan-codebase
EnvironmentFile=-/root/Dhan-codebase/.env
ExecStart=/root/Dhan-codebase/.venv/bin/python -m run.main --engine-id dhan_leaps_rsi
Restart=on-failure
RestartSec=300
TimeoutStopSec=120
StandardOutput=append:/root/dhan.log
StandardError=append:/root/dhan.err.log

[Install]
WantedBy=multi-user.target
